# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here

# Shazam API Configuration (from RapidAPI)
SHAZAM_API_TOKEN=your_shazam_api_token_here

# Your Telegram account ID
OWNER_ID=owner_telegram_id

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=pretty

# Rate limiting
RATE_LIMIT_SECONDS=30

# Max file sizes in MB (converted to bytes internally with 1024*1024)
MAX_FILE_SIZE_VIDEO=45
MAX_FILE_SIZE_AUDIO=6